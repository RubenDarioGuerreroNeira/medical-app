# ===== Base de datos =====
# Opcion A (recomendado para desarrollo sin instalar Postgres): Postgres en la nube
# Neon / Supabase / Railway (gratis). Solo pega tu connection string.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Opcion B (Postgres local o Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password123
DB_NAME=medical_db

# Opcion C (SQLite solo para desarrollo rapido; requiere DB_TYPE=sqlite y adaptaciones)
# DB_TYPE=sqlite
# SQLITE_PATH=./dev.sqlite

# ===== Seguridad =====
JWT_SECRET=super_secret_key_change_me
NODE_ENV=development

# ===== Servicios externos (opcionales en dev) =====
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
CLOUDINARY_URL=

# ===== Mail (opcional) =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@medical.app

# ===== Redis (opcional, el bot funciona sin Redis) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Redis (opcional, el bot funciona sin Redis) =====
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS=false

# ===== Telegram Webhook (P0.1) =====
TELEGRAM_WEBHOOK_URL=https://tu-dominio.com
TELEGRAM_WEBHOOK_SECRET_TOKEN=tu_secret_token_seguro
